# Copy to .env and fill the ones you use. Never commit .env.
# config.yaml references these via $VAR syntax.
# 填完验证:uv run rootrecall models(只查非空,不打印值)。
# ⚠️ .env 是机器相关的:ROOTRECALL_HOME / ROOTRECALL_CODEBASES 等路径变量由 quickstart
#    按本机写入 —— 换新设备只把 key 值抄过去,别整份拷 .env(旧机路径带过去,数据落盘
#    会 PermissionError;踩坑实录 2026-08-25)。

# ── 必填(最小可用集,两个 key 起步)────────────────────────────────────

# 所有 LLM 角色(default/planner/locator/summarizer/verifier/memory_extractor/title)
# 走的 deepseek-v4-pro / v4-flash 都用这个 key;不填则模型一调就 401。
DEEPSEEK_API_KEY=

# 阿里云百炼:`rootrecall index` 的 embedding(text-embedding-v4)+ reranker
# (qwen3-rerank)共用这一个 key;不填则建索引 / search_codebase 起不来。
DASHSCOPE_API_KEY=

# ── 按需(用到再填)─────────────────────────────────────────────────────

# 仅当把某个模型角色切到 gpt-4.1 时填(默认角色全走 deepseek)。
OPENAI_API_KEY=

# 仅当启用 config.yaml 里注释掉的 Claude 备选模型时填。
ANTHROPIC_API_KEY=

# DashScope 专属 MaaS 端点(团队设备默认已填,比公共 serverless 更快更稳);
# 公共 serverless 用户:把两行的值清空,代码自动回落 dashscope.aliyuncs.com 公共端点。
DASHSCOPE_BASE_URL=https://llm-043c7bxvhucnjvk5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://llm-043c7bxvhucnjvk5.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 仅当把 embedding/reranker 切到 SiliconFlow 备选(config.yaml fallback 注释方案)时填。
SILICONFLOW_API_KEY=

# patch-review / fetch_patch 抓 GitHub PR 用:匿名 60 次/小时,配 token 5000 次/小时。
# classic token 不勾任何 scope(只读公开仓)即可。
GITHUB_TOKEN=

# 自托管 Langfuse 可观测(platform/tracing.py);不用则全留空。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
