# 本地 demo 金标准(example/demo1、demo2:含 wpa 源码树 + 日志 + 漏洞 PDF + 报告/补丁)。
# 本地独享不入库(含完整 wpa 源码树 + 嵌套 .git,110M);Mac 那台做 R2 时需手动拷贝。
example/

# 本地测试素材仓(code-test/:两个版本的 bluez 5.50/5.85 源码树,54M,跨版本/补丁分析实测用)。
# 第三方系统软件源码不入库;各机器自行放置。ruff 默认 respect-gitignore → 也免扫它的 lint 噪声。
code-test/

# L2 导航 fixture 的 compile_commands.json(由 tests/fixtures/lsp_c/gen_compile_commands.sh 生成,
# 绝对路径因机器而异,不提交)
tests/fixtures/lsp_c/compile_commands.json

# clangd 后台索引缓存(--background-index 生成,机器相关、可重建,不提交)
.cache/

# Reference implementations — clone separately on each machine(只读参考,各自 clone)
#   git clone https://github.com/bytedance/deer-flow
deer-flow/
#   git clone https://github.com/tirth8205/code-review-graph  (P1.3 借鉴:SQLite 图/增量/原子性/hybrid/eval)
code-review-graph/
